DATABASE_URL=postgresql+psycopg://entreggo:entreggo@localhost:5432/entreggo

# Firebase Authentication: ID do projeto (Configurações do projeto > Geral)
FIREBASE_PROJECT_ID=seu-projeto-firebase

# Geocodificação: com chave usa Google; vazio usa OpenStreetMap (Nominatim)
GOOGLE_MAPS_API_KEY=
NOMINATIM_CONTACT=seu-email@exemplo.com

MAX_IMPORT_BYTES=5000000
MAX_IMPORT_ROWS=2000
